# PostgreSQL / Drizzle
# Replace with your database connection string.
DATABASE_URL="postgresql://user:password@host:5432/db_name"

# Hack Club Auth OAuth
# Create an OAuth application at https://auth.hackclub.com and copy its credentials here.
HCA_CLIENT_ID="your_hack_club_auth_client_id"
HCA_CLIENT_SECRET="your_hack_club_auth_client_secret"

# The public base URL of this app (no trailing slash).
# Local development: http://localhost:5173
HCA_REDIRECT_ADDRESS="http://localhost:5173"

#Upload thing token 
UPLOADTHING_TOKEN="your_uploadthing_token"
